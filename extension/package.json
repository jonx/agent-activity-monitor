{
  "name": "agent-activity-monitor",
  "displayName": "Agent Activity Monitor",
  "description": "See what Claude Code and Codex are running right now: commands, background jobs, sub-agents and processes, per session and per project.",
  "version": "0.1.0",
  "publisher": "jonx",
  "author": {
    "name": "John Knipper",
    "email": "code@jkn.me"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonx/agent-activity-monitor"
  },
  "homepage": "https://github.com/jonx/agent-activity-monitor#readme",
  "bugs": {
    "url": "https://github.com/jonx/agent-activity-monitor/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "agent",
    "monitor",
    "processes",
    "activity"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#1b2440",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeActivity",
          "title": "Agent Activity",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeActivity": [
        {
          "id": "claudeActivity.tree",
          "name": "Running"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeActivity.refresh",
        "title": "Claude Activity: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeActivity.openLog",
        "title": "Claude Activity: Open event log",
        "icon": "$(output)"
      },
      {
        "command": "claudeActivity.clearLog",
        "title": "Claude Activity: Clear event log"
      },
      {
        "command": "claudeActivity.kill",
        "title": "Kill process",
        "icon": "$(close)"
      },
      {
        "command": "claudeActivity.copy",
        "title": "Copy command"
      },
      {
        "command": "claudeActivity.pause",
        "title": "Pause process (SIGSTOP)",
        "icon": "$(debug-pause)"
      },
      {
        "command": "claudeActivity.resume",
        "title": "Resume process (SIGCONT)",
        "icon": "$(debug-continue)"
      },
      {
        "command": "claudeActivity.hideSession",
        "title": "Hide session from view",
        "icon": "$(eye-closed)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeActivity.refresh",
          "when": "view == claudeActivity.tree",
          "group": "navigation"
        },
        {
          "command": "claudeActivity.openLog",
          "when": "view == claudeActivity.tree",
          "group": "navigation"
        },
        {
          "command": "claudeActivity.clearLog",
          "when": "view == claudeActivity.tree"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeActivity.pause",
          "when": "view == claudeActivity.tree && viewItem == process",
          "group": "inline@1"
        },
        {
          "command": "claudeActivity.resume",
          "when": "view == claudeActivity.tree && viewItem == pausedProcess",
          "group": "inline@1"
        },
        {
          "command": "claudeActivity.kill",
          "when": "view == claudeActivity.tree && (viewItem == process || viewItem == pausedProcess)",
          "group": "inline@2"
        },
        {
          "command": "claudeActivity.hideSession",
          "when": "view == claudeActivity.tree && viewItem == session",
          "group": "inline"
        },
        {
          "command": "claudeActivity.copy",
          "when": "view == claudeActivity.tree && (viewItem == process || viewItem == pausedProcess || viewItem == tool)"
        }
      ]
    },
    "configuration": {
      "title": "Agent Activity",
      "properties": {
        "claudeActivity.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "description": "How often to scan processes (ms)."
        },
        "claudeActivity.logPath": {
          "type": "string",
          "default": "",
          "description": "Path of events.jsonl (default: ~/.claude/activity/events.jsonl)."
        },
        "claudeActivity.recentCount": {
          "type": "number",
          "default": 8,
          "description": "How many finished calls to keep per session."
        },
        "claudeActivity.staleMinutes": {
          "type": "number",
          "default": 15,
          "description": "Hide sessions with no live process and no event for this many minutes."
        }
      }
    }
  }
}
