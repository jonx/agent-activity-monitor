{
  "name": "agent-activity-monitor",
  "displayName": "Agent Activity Monitor",
  "description": "See what Claude Code and Codex are running right now: commands, background jobs, sub-agents and processes, per session and per project.",
  "version": "0.1.3",
  "publisher": "Jkn",
  "author": {
    "name": "John Knipper",
    "email": "code@jkn.me"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonx/agent-activity-monitor"
  },
  "homepage": "https://github.com/jonx/agent-activity-monitor#readme",
  "bugs": {
    "url": "https://github.com/jonx/agent-activity-monitor/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "agent",
    "monitor",
    "processes",
    "activity"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#1b2440",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentActivity",
          "title": "Agent Activity",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentActivity": [
        {
          "id": "agentActivity.tree",
          "name": "Running"
        }
      ]
    },
    "commands": [
      {
        "command": "agentActivity.refresh",
        "title": "Agent Activity: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentActivity.openLog",
        "title": "Agent Activity: Open event log",
        "icon": "$(output)"
      },
      {
        "command": "agentActivity.clearLog",
        "title": "Agent Activity: Clear event log"
      },
      {
        "command": "agentActivity.kill",
        "title": "Kill process",
        "icon": "$(close)"
      },
      {
        "command": "agentActivity.copy",
        "title": "Copy command"
      },
      {
        "command": "agentActivity.pause",
        "title": "Pause process (SIGSTOP)",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentActivity.resume",
        "title": "Resume process (SIGCONT)",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentActivity.hideSession",
        "title": "Hide session from view",
        "icon": "$(eye-closed)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentActivity.refresh",
          "when": "view == agentActivity.tree",
          "group": "navigation"
        },
        {
          "command": "agentActivity.openLog",
          "when": "view == agentActivity.tree",
          "group": "navigation"
        },
        {
          "command": "agentActivity.clearLog",
          "when": "view == agentActivity.tree"
        }
      ],
      "view/item/context": [
        {
          "command": "agentActivity.pause",
          "when": "view == agentActivity.tree && viewItem == process",
          "group": "inline@1"
        },
        {
          "command": "agentActivity.resume",
          "when": "view == agentActivity.tree && viewItem == pausedProcess",
          "group": "inline@1"
        },
        {
          "command": "agentActivity.kill",
          "when": "view == agentActivity.tree && (viewItem == process || viewItem == pausedProcess || viewItem == processNoPause)",
          "group": "inline@2"
        },
        {
          "command": "agentActivity.hideSession",
          "when": "view == agentActivity.tree && viewItem == session",
          "group": "inline"
        },
        {
          "command": "agentActivity.copy",
          "when": "view == agentActivity.tree && (viewItem == process || viewItem == pausedProcess || viewItem == processNoPause || viewItem == tool)"
        }
      ]
    },
    "configuration": {
      "title": "Agent Activity",
      "properties": {
        "agentActivity.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "description": "How often to scan processes (ms)."
        },
        "agentActivity.logPath": {
          "type": "string",
          "default": "",
          "description": "Path of events.jsonl (default: ~/.agent-activity/events.jsonl)."
        },
        "agentActivity.recentCount": {
          "type": "number",
          "default": 8,
          "description": "How many finished calls to keep per session."
        },
        "agentActivity.staleMinutes": {
          "type": "number",
          "default": 15,
          "description": "Hide sessions with no live process and no event for this many minutes."
        }
      }
    }
  }
}
